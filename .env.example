# ── Existing (already configured) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
# Server only - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── New: public URL of this deployment (used for Telegram webhooks + GitHub callbacks) ──
PUBLIC_BASE_URL=https://your-domain.example

# ── New: server secrets (32+ random bytes each; generate with: openssl rand -base64 48) ──
# If unset they are derived from SUPABASE_SERVICE_ROLE_KEY. Set them BEFORE first use and
# never change them afterwards (encrypted bot tokens / API key hashes depend on them).
APP_ENCRYPTION_KEY=
HASH_PEPPER=
CALLBACK_SECRET=
ADMIN_JWT_SECRET=

# ── New: hidden admin console at /api/<ADMIN_PATH> (16-64 chars of A-Z a-z 0-9 _ -, must not start with "admin") ──
ADMIN_PATH=
ADMIN_EMAIL=
# bcrypt hash from:  npm run admin:hash
ADMIN_PASSWORD_HASH=

# ── New: CORS allowlists (comma separated origins). Same-origin is always allowed. ──
CORS_ORIGINS=
# Extra origins allowed to call /api/v1 from a browser (leave empty: call the API server-to-server)
API_CORS_ORIGINS=

# Standalone server only
PORT=8080
